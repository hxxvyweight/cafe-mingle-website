---
import '../styles/global.css';
const { title } = Astro.props;
import { Image } from 'astro:assets';
import Instagram from '../assets/instagram.svg';
import Facebook from '../assets/facebook.svg';
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class=" bg-[#FDF1d6] text-stone-900 font-sans antialiased selection:bg-[#533A2F] selection:text-white max-w-screen">
    <slot />

    <footer class="min-h-[45vh] md:min-h-[70vh] grid grid-cols-1 md:grid-cols-3 gap-8 justify-evenly items-start text-center bg-[#533A2] text-center py-16">

      <div class="flex flex-col gap-8 p-6">
        <h1 class="font-sans text-4xl font-bold">Visit Us</h1>
       
        <div class="flex flex-col items-center justify-center gap-4 bg-white/60 p-16 rounded-2xl border border-stone-200/50">
        <h3 class="text-xl font-bold text-stone-900 mb-3">Trading Hours</h3>
        <p class="text-xl font-bold">Tuesday-Saturday</p>
        <p class="">7:30 am - 5:30 pm</p>
        
        </div>
        <div class="flex flex-col items-center justify-center gap-4 bg-white/60 p-16 rounded-2xl border border-stone-200/50">
        <h3 class="text-xl font-bold text-stone-900 mb-3">Contact Us</h3>
        <p class="text-stone-600 leading-relaxed text-sm">A welcoming atmosphere designed to help you slow down and enjoy the simple things.</p>
      
      </div>
      
    </div>

      <div>
        <p class="text-4xl font-black self-center">Don't Miss Out by following our Socials!</p>
      </div>
      
      
      <div class="max-h-auto max-w-auto flex gap-4 justify-center">
        <a href="https://www.instagram.com/cafe_mingle_">
        <Image src={ Instagram } alt="Instagram Logo SVG" class="h-auto w-15 hover:border-3 hover:bg-gradient-to-br rounded-xl transition-all 1s bg-clip from-[#feda75] via-[#fa7e1e] via-[#d62976] to-[#962fbf] to-[#4f5bd5] ease-in-out"/>
        </a>
        <a href="https://www.facebook.com/cafemingleoakflats/">
        <Image src={ Facebook } alt="Instagram Logo SVG" class="h-auto w-15 hover:border-3 rounded-xl transition-all 1s bg-clip hover:bg-[#1877F2] ease-in-out"/>
        </a>
      </div>


    </footer>

  </body>
</html>