---
import '../styles/global.css';
const { title } = Astro.props;
import { Image } from 'astro:assets';
import Instagram from '../assets/instagram.svg';
import Facebook from '../assets/facebook.svg';
---
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body class="bg-[#FDF1d6] text-stone-900 font-sans antialiased selection:bg-[#533A2F] selection:text-white max-w-screen">
    <slot />

    <footer class="min-h-[45vh] md:min-h-[70vh] flex justify-between items-start px-24 bg-[#533A2] text-center py-16">

      <div class="flex flex-col">
        <h1 class="font-sans text-4xl font-bold">Trading Hours </h1>
        <p class="text-xl font-bold">Tuesday-Saturday</p>
        <p class="">7:30 am - 5:30 pm</p>
      </div>

      <div>
        <p class="text-4xl font-black">Don't Miss Out by following our Socials!</p>
      </div>
      
      
      <div class="max-h-auto max-w-auto flex gap-8 justify-center">
        <a href="https://www.instagram.com/cafe_mingle_">
        <Image src={ Instagram } alt="Instagram Logo SVG" class="h-auto w-15"/>
        </a>
        <a>
        <Image src={ Facebook } alt="Instagram Logo SVG" class="h-auto w-15"/>
        </a>
      </div>

      <div class="gridm       "

    </footer>

  </body>
</html>