---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Menu from '../assets/menu.webp';
import MenuTwo from '../assets/menu2.webp';

---
<Layout title="Cafe Mingle | Korean-Inspired Cafe">
  
  <!-- HEADER & NAVIGATION -->
  <header class="w-full max-w-6xl mx-auto px-6 py-10">
    <div class="flex flex-col-reverse md:flex-row justify-between items-center gap-6">
      <nav class="flex flex-wrap gap-6 text-sm font-semibold text-stone-600 tracking-wide uppercase">
        <a href="/" class="hover:text-[#533A2F] transition-colors nav-animate" aria-label="View the Home screen for Cafe Mingle">Home</a>
        <a href="/#about" class="hover:text-[#533A2F] transition-colors nav-animate" aria-label="Go to About Section on Home Page for Cafe Mingle">About</a>
        <a href="/find-us" class="hover:text-[#533A2F] transition-colors nav-animate" aria-label="View Find-Us Page for Cafe Mingle">Find Us</a>
        <a href="/menu" class="hover:text-[#533A2F] transition-colors nav-animate" aria-label="View Menu Page containing two clickable Menu's">Menu</a>
      </nav>
      <div class="text-left md:text-right">
        <h2 class="text-2xl font-bold tracking-widest text-stone-900 uppercase">Cafe Mingle</h2>
        <p class="text-xs font-[500] text-stone-900 tracking-widest uppercase mt-1">Korean-Inspired Cafe | 한국풍 카페</p>
      </div>
    </div>
  </header>

  <section class="w-full max-w-screen min-h-[90vh] mx-auto px-8 py-12 md:py-20 grid grid-cols-1 md:grid-cols-2  gap-8 md:items-center md:text-center ">

    <div class="w-full">
        <Image src= { Menu } alt="Menu Image 1" class="zoom-img rounded-2xl w-full object-cover h-auto transition-all duration-300 cursor-zoom-in" loading="eager"/>

    </div>
    
    <div class="w-full">
        <Image src={ MenuTwo }  alt="Menu Image 2" class="zoom-img rounded-2xl w-full object-cover h-auto transition-all duration-300 cursor-zoom-in" loading="eager"/>

    </div>
    
  
  </section>

  <section class="w-full max-w-6xl mx-auto px-6 py-16">
    
  </section>

</Layout>

<script>
    const img = document.querySelectorAll('.zoom-img');
    
    img.forEach(img => {
        img.addEventListener('click', () => {
            img.classList.toggle('zoomed');
        });
    });
</script>