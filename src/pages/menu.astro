---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Menu | Cafe Mingle Oak Flats">
    
    <div class="menu-heading">
        <h1>Our Menu</h1>
    </div>
    
    <main class="menu-page-container">
        <section class="container-menu">
            <a href="/menu.webp" target="_blank">
                <img src="/menu.webp" alt="Cafe Mingle Menu" width=500 height=700 class="responsive-menu" />
            </a>
            <p class="tap-text">👆 Tap menu to zoom or view full size</p>     
           
            <a href="/menu2.webp" target="_blank">
                <img src="/menu2.webp" alt="Cafe Mingle Menu" width=500 height=700 class="responsive-menu" />
            </a>
            <p class="tap-text">👆 Tap menu to zoom or view full size</p>     
        </section>
    </main>

    <div class="menu-footer-notice">
        <p>Notice an item missing? Since our kitchen rotates seasonal treats, ask our friendly counter staff about daily cabinet specials!</p>
    </div>

</Layout>