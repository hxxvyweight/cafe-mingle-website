---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import DoorDash from '../assets/doordash.jpg';
import coffeeLogo from '../assets/coffee.webp';
import Storefront from '../assets/storefront.webp';
import Sunset from '../assets/insta2.avif';
import GoogleMaps from '../assets/googleMaps.png';
---

<Layout title="Cafe Mingle | Korean-Inspired Cafe">
  
  <header class="w-full max-w-6xl mx-auto px-6 py-10">
    <div class="flex flex-col-reverse md:flex-row justify-between items-center gap-6">
      <nav class="flex flex-wrap gap-6 text-sm font-semibold text-stone-600 tracking-wide uppercase">
        <a href="/" class="hover:text-[#533A2F] transition-colors nav-animate active:text-amber-400">Home</a>
        <a href="#about" class="hover:text-[#533A2F] transition-colors nav-animate active:text-amber-400">About</a>
        <a href="/find-us" class="hover:text-[#533A2F] transition-colors nav-animate active:text-amber-400">Find Us</a>
        <a href="/menu" class="hover:text-[#533A2F] transition-colors nav-animate active:text-amber-400">Menu</a>
      </nav>
      <div class="text-left md:text-right">
        <h2 class="text-2xl font-bold tracking-widest text-stone-900 uppercase">Cafe Mingle</h2>
        <p class="text-xs font-medium text-stone-900 tracking-widest uppercase mt-1">Korean-Inspired Cafe | 한국풍 카페</p>
      </div>
    </div>
  </header>

  <main class="relative overflow-hidden bg-[#CD7F55] w-full min-h-[90vh] py-12 md:py-20">
    <div class="w-full max-w-6xl mx-auto px-6 flex flex-col items-center text-center">
      
      <div class="w-64 h-64 mb-12 rounded-full bg-[#533A2F] shadow-xl flex items-center justify-center p-4 border-8 border-white/50">
         <Image src= { coffeeLogo} alt="Cafe Mingle Logo" class="w-full h-full object-contain max-w-full" fetchpriority="high" loading="eager"/>
      </div>

      <h1 class="text-4xl md:text-6xl font-black text-stone-800 tracking-tight mb-6">
        Warm, Simple & Full of Flavour
      </h1>
      <p class="text-lg text-stone-900 font-medium leading-relaxed mb-10 max-w-2xl tracking-wide">
        Your local cozy spot in Oak Flats for specialty treats, bright fruit teas, and beautiful dessert boxes.
      </p>

      <div class="flex gap-4 items-center justify-center">
      
        <div class="flex flex-col items-center gap-4 justify-between flex-wrap">
        <p class="italic px-8 py-4 text-black font-bold tracking-widest rounded-lg nav-animate">
          Order Online Via
        </p>
        <div class="flex gap-8">
          <a href="https://www.doordash.com/en-AU/store/cafe-mingle-oak-flats-35394099">
          <Image src={ DoorDash } alt="Door Dash Logo" class="relative self-center  max-w-40 min-w-40 min-w-40 min-h-15 h-auto bg-white transition-transform border-2 shadow-md duration-300 ease-in-out  rounded-2xl  hover:-translate-y-1 ease-out p-2"/>
          </a>
          <a href="https://www.ubereats.com/au/store/cafe-mingle/xHo94lp7SEaBVttxOzbApQ?srsltid=AfmBOoqWYOZ5gQXyCkNh9NY-GAaWzpYTUCrHZzAlZcpBS9E4QKGf3umO">
          <img src="/ubereats.svg" alt="Door Dash Logo" class="relative w-40 h-15 min-w-40 h-15 object-contain bg-[#06C167] rounded-2xl border-2 shadow-md transition-transform duration-300 ease-out hover:-translate-y-1 active:bg-white p-2"/>
        </a>
      </div>
      </div>
        
        
      </div>
    
    </div>
  </main>

  <section class="grid grid-cols-1 w-full h-full mx-auto px-6 py-16 text-center">
    
    <h2 class="text-2xl md:text-3xl font-bold text-stone-800 mb-10 border-b-2 border-[#533A2F]/20 pb-4 inline-block">
      Where to find Us!
    </h2>

    <div class="relative grid grid-cols-1 place-items-center md:p-16 gap-8">
      
      <div class="flex flex-col gap-4  w-auto h-auto rounded-2xl border border-stone-200/50">
        <a href="https://www.google.com/maps/place/Cafe+mingle/@-34.5648142,150.8182504,16.7z/data=!4m6!3m5!1s0x6b131304aad69f17:0x2c06c0b65c8d2ad2!8m2!3d-34.5646522!4d150.8190975!16s%2Fg%2F11mcxj8m6n?entry=ttu&g_ep=EgoyMDI2MDYyNC4wIKXMDSoASAFQAw%3D%3D">
        <Image src={ GoogleMaps } alt="SVG Icon of Coffee Cup" class="md:w-3xl w-5xl h-auto rounded-xl"/>
      </a>
    </div>



    <div class="grid grid-cols-1 h-sm w-xl gap-8 z-20 max-w-fit hidden">

      <Image src={ Storefront } alt="Front of the Store Photo" class="rounded-sm w-xl"/>
      <Image src={ Sunset } alt="Front of the Store Photo" class="rounded-sm"/>


    </div>

    </div>
  
  </section>

</Layout>