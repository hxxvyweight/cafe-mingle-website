---
import Layout from '../layouts/Layout.astro';
import Breakfast from '../assets/BigBreakfast.webp';
import { Image } from 'astro:assets';
import Beans from '../assets/belaroma.webp';
import Food from '../assets/food2.webp';
import Menu from '../assets/menu.webp';
import Coffee from '../assets/CoffeeFull.webp';
import beanIcon from '../assets/coffeeBean.svg';
import CoffeeIcon from '../assets/coffee.svg';
import Dog from '../assets/dog.svg';
import Drinks from '../assets/drinks.webp';
import FoodTwo from '../assets/food3.webp';
import FoodThree from  '../assets/food.webp';
const menuCategories = [
  {
    category: "Coffee & Hot Drinks",
    items: [
      { name: "SHORT BLACK (ESPRESSO)", price: "3.5" },
      { name: "MACCHIATO | PICCOLO LATTE", price: "4.0" },
      { name: "LONG BLACK | CAPPUCCINO | FLAT WHITE | LATTE", price: "S 4.5 L 5.2" },
      { name: "MOCHA | HOT CHOCOLATE", price: "S 4.5 L 5.2" },
      { name: "CHAI LATTE | MATCHA LATTE", price: "S 5.2 L 5.9" },
      { name: "DIRTY CHAI LATTE | DIRTY MATCHA LATTE", price: "S 5.8 L 6.2" },
      { name: "BABYCCINO", price: "2.0" }
    ]
  },
  {
    category: "Additions",
    items: [
      { name: "ADDITIONS", price: "60c" },
      { name: "Extra Shot", subtext: true },
      { name: "Almond | Lactose Free | Oat | Soy", subtext: true },
      { name: "Caramel | Hazelnut | Vanilla Syrups | Cream", subtext: true }
    ]
  },
  {
    category: "Cup of Ice Cream",
    items: [
      { name: "CUP OF ICE CREAM", price: "$5" },
      { name: "2 Scoops Ice Cream", subtext: true },
      { name: "Vanilla | Matcha | Coffee", subtext: true },
      { name: "Choice of Syrup (Choco / Caramel / Strawberry)", subtext: true }
    ]
  },
  {
    category: "Soft Drinks",
    items: [
      { name: "SOFT DRINKS", price: "$3" },
      { name: "Spring Water | Sparkling Water", subtext: true },
      { name: "Coke | Coke Zero | Lemonade", subtext: true },
      { name: "Lemon Lime Bitter | Welch's", subtext: true }
    ]
  },
  {
    category: "Tea",
    items: [
      { name: "TEA", price: "$5 per person" },
      { name: "English Breakfast | Earl Grey | Green Tea", subtext: true },
      { name: "Peppermint | Chamomile", subtext: true },
      { name: "Lemongrass & Ginger", subtext: true }
    ]
  },
  {
    category: "Cold Drinks & Juices",
    items: [
      { name: "AFFOGATO", price: "5.0" },
      { name: "ICED LONG BLACK", price: "6.5" },
      { name: "ICED LATTE", price: "6.5" },
      { name: "ICED CHOCO | ICED COFFEE | ICED MOCHA", price: "8.0" },
      { name: "Served with Ice Cream & Whipped Cream", subtext: true },
      { name: "ICED CHAI | ICED MATCHA", price: "8.0" },
      { name: "Served with Ice Cream & Whipped Cream", subtext: true },
      { name: "MILKSHAKE", price: "S 6.5 L 8.5" },
      { name: "Choco | Caramel | Strawberry | Vanilla", subtext: true },
      { name: "Thick shake +$1.5", subtext: true },
      { name: "FRESH FRUIT JUICE", price: "8.5" },
      { name: "Orange | Apple | Watermelon", subtext: true },
      { name: "Pineapple | Carrot | Ginger", subtext: true },
      { name: "ADE", price: "8.0" },
      { name: "Honey Yuza | Honey Ginger", subtext: true },
      { name: "SMOOTHIES", price: "8.5" },
      { name: "Banana | Strawberry | Blueberry | Matcha", subtext: true }
    ]
  }
];


---

<Layout title="Cafe Mingle | Korean-Inspired Cafe">
  
  <header class="w-full max-w-6xl mx-auto px-6 py-10">
    <div class="flex flex-col-reverse md:flex-row justify-between items-center gap-6">
      <nav class="flex flex-wrap gap-6 text-sm font-semibold text-stone-600 tracking-wide uppercase">
        <a href="/" class="hover:text-[#533A2F] transition-colors nav-animate">Home</a>
        <a href="#about" class="hover:text-[#533A2F] transition-colors nav-animate">About</a>
        <a href="/find-us" class="hover:text-[#533A2F] transition-colors nav-animate">Find Us</a>
        <a href="/menu" class="hover:text-[#533A2F] transition-colors nav-animate">Menu</a>
      </nav>
      <div class="text-left md:text-right">
        <h2 class="text-2xl font-bold tracking-widest text-stone-900 uppercase">Cafe Mingle</h2>
        <p class="text-xs text-stone-500 tracking-widest uppercase mt-1">Korean-Inspired Cafe | 한국풍 카페</p>
      </div>
    </div>
  </header>

  <main class="bg-[#CD7F55] w-full min-h-[90vh] py-12 md:py-20">
    <div class="w-full max-w-6xl mx-auto px-6 flex flex-col items-center text-center">
      
      <div class="w-64 h-64 mb-12 rounded-full bg-[#533A2F] shadow-xl flex items-center justify-center p-4 border-8 border-white/50">
         <img src="/coffee.webp" alt="Cafe Mingle Logo" class="w-full h-full object-contain max-w-full" />
      </div>

      <h1 class="text-4xl md:text-6xl font-black text-stone-800 tracking-tight mb-6">
        Warm, Simple & Full of Flavour
      </h1>
      <p class="text-lg text-stone-900 font-medium leading-relaxed mb-10 max-w-2xl tracking-wide">
        Your local cozy spot in Oak Flats for specialty treats, bright fruit teas, and beautiful dessert boxes.
      </p>

      <div class="flex gap-4 items-center justify-center">
      
        <div class="flex flex-col items-center gap-4 justify-between flex-wrap">
        <p class="italic px-8 py-4 text-white font-bold tracking-wide rounded-lg nav-animate">
          Order Online Via
        </p>
        <div class="flex gap-8">
          <a href="https://www.doordash.com/en-AU/store/cafe-mingle-oak-flats-35394099">
          <img src="/doordash.svg" alt="Door Dash Logo" class="max-w-40 h-15 object-contain bg-brand-red active:bg-white hover:bg-white transition-all ease-in-out rounded-2xl border-2 shadow-md px-14 hover:-translate-y-1 ease-out"/>
          </a>
          <a href="https://www.ubereats.com/au/store/cafe-mingle/xHo94lp7SEaBVttxOzbApQ?srsltid=AfmBOoqWYOZ5gQXyCkNh9NY-GAaWzpYTUCrHZzAlZcpBS9E4QKGf3umO">
          <img src="/ubereats.svg" alt="Door Dash Logo" class="max-w-40 h-15 object-contain bg-[#06C167] rounded-2xl border-2 shadow-md px-14 transition-transform duration-300 ease-out hover:-translate-y-1 active:bg-white hover:bg-white"/>
        </a>
      </div>
      </div>
        
        
      </div>
    
    </div>
  </main>

  <section class="w-full max-w-[90vw] mx-auto px-6 py-16">
    <h2 class="text-2xl md:text-3xl font-bold text-stone-800 mb-10 border-b-2 border-[#533A2F]/20 pb-4 inline-block">
      Why Choose Cafe Mingle
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <div class="flex flex-col items-center justify-center gap-4 bg-white/60 p-16 rounded-2xl border border-stone-200/50">
        <h3 class="text-xl font-bold text-stone-900 mb-3">Cozy Brunch</h3>
        <p class="text-stone-600 leading-relaxed text-sm">A welcoming atmosphere designed to help you slow down and enjoy the simple things.</p>
        <Image src={ beanIcon } alt="SVG Icon of Coffee Cup" class="w-18 h-auto"/>
      </div>
      <div class="flex flex-col items-center justify-center gap-4 bg-white/60 p-16 rounded-2xl border border-stone-200/50 ">
        <h3 class="text-xl font-bold text-stone-900 mb-3">Easy Parking</h3>
        <p class="text-stone-600 leading-relaxed text-sm">No stress needed. We have a convenient parking lot located right nearby.</p>
        <Image src={ CoffeeIcon } alt="SVG Icon of Coffee Cup" class="w-18 h-auto"/>
      </div>
      <div class="flex flex-col items-center justify-center gap-4 bg-white/60 p-16 rounded-2xl border border-stone-200/50">
        <h3 class="text-xl font-bold text-stone-900 mb-3">Pet Friendly</h3>
        <p class="text-stone-600 leading-relaxed text-sm">Four-legged friends are always welcome! Bring your pup along for your morning coffee.</p>
        <Image src={ Dog } alt="SVG Icon of Coffee Cup" class="w-18 h-auto"/>
      </div>
    </div>
  </section>

  <section id="about"class="bg-[#1a1311] min-w-full min-h-screen  py-12 md:py-20 items-center">
    <div class="w-full max-w-6xl mx-auto px-6 flex flex-col justify-between items-center text-center">
      
      <h1 class="text-4xl md:text-6xl font-black text-zinc-100 tracking-tight mb-6">
        About Us
      </h1>
      <p class="text-lg text-zinc-100 font-medium leading-relaxed">Welcome to Cafe Mingle, where Korean hospitality meets the perfect cup of coffee. We are passionate about creating a cozy space in the heart of 
        Oak Flats where friends and family can gather, relax, and enjoy a unique blend of flavors.
        We take great pride in the quality of our brew, which is why we exclusively serve premium Belaroma coffee beans. Whether you are stopping by for your morning caffeine fix or settling in for a delicious treat, we look forward to welcoming you into our cafe.
      </p>
      
    </div>

    <div class="flex flex-col px-8 py-16 min-w-full place-items-center justify-center gap-16">
      <div class="flex flex-col min-h-[70vh]">
      <p class="text-white text-xl tracking-widest italic self-center flex flex-col p-2">Proud to Serve High Quality Belaroma Coffee Beans<span class="text-sm self-center">Try clicking the photo!</span></p>
      <a href="https://www.sevenmiles.com.au/products/belaroma-range?srsltid=AfmBOooW_US_i8oRv4VMdEGwzImZqiDoiDdapojE2kdGvJD0c6JRVND3">
      <Image src={ Beans } alt="Belaroma Coffee Beans" class="w-full max-h-120 rounded-2xl shadow-xl hover:-translate-y-2 duration-300 ease-in-out "/>
      </a>
      </div>
      
      <div class="flex flex-col text-white gap-8 items-start min-h-[70vh]">
      <p class="text-white text-xl tracking-widest italic self-center flex flex-col p-2 items-start text-left">Discover Our Menu<span class="text-sm">To View our Full Menu, Click the text or Image Below</span></p>
      
      <a href="/menu">
        <div>
      {menuCategories.map((cat) => (
        <div class="category-block">
        {cat.items.map((item) => (
        <p class="text-white tracking-widest p-2">
        {item.name} {item.price ? ` ${item.price}` : ''}
        </p>
      ))}
      </div>
      ))}
    </div>
      <Image src={ Menu } alt="Belaroma Coffee Beans" class="w-xl md:min-w-150 h-auto rounded-2xl shadow-xl hover:-translate-y-2 duration-300 ease-in-out "/>
      </a>
      </div>
      
      <p class="text-3xl tracking-widest font-light  text-white mb-12 mt-14 italic">Take a Sneek Peek at some Items!</p>
      <div class="grid md:grid-cols-3 gap-8 justify-center place-items-center h-auto  max-w-4xl">
      <Image src={ Food } alt="Store Front" class="w-full max-h-full rounded-2xl shadow-xl hover:-translate-y-2 duration-300 ease-in-out"/>
      <Image src={ Drinks } alt="Store Front" class="w-full max-h-full rounded-2xl shadow-xl hover:-translate-y-2 duration-300 ease-in-out"/>
      <Image src={ FoodTwo } alt="Store Front" class="w-full rounded-2xl shadow-xl hover:-translate-y-2 duration-300 ease-in-out "/>
      <Image src={ FoodThree } alt="Store Front" class="w-full max-h-full rounded-2xl shadow-xl hover:-translate-y-2 duration-300 ease-in-out "/>
      <Image src={ Coffee } alt="Store Front" class="w-full max-h-full rounded-2xl shadow-xl hover:-translate-y-2 duration-300 ease-in-out "/>
      <Image src={ Breakfast } alt="Store Front" class="w-full rounded-2xl shadow-xl hover:-translate-y-2 duration-300 ease-in-out "/>
      </div>
    </div>
        
        
    
  </section>
</Layout>